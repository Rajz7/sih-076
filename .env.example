# Copy this file to .env. Keep the OpenAI key server-side; never prefix it with EXPO_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano
PORT=3333
HOST=0.0.0.0

# Set this to your computer's LAN IP for a physical phone, e.g. http://192.168.1.25:3333
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3333